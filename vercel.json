{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "includeFiles": "server/prompts/*.prompt.md",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/stories/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/chats/:path*",
      "destination": "/index.html"
    }
  ]
}
